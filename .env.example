# Root .env — read by docker-compose itself.
# Copy to .env on the VPS and fill in real values.

# Postgres credentials (used by both postgres container and backend DATABASE_URL).
POSTGRES_USER=ckg_ai
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=ckg_ai

# Release tag of the registry.medisy.id/ckg-* images to run (docker-compose.prod.yml).
# Must be a tag the "Push Docker Images" workflow has published, e.g. v1.1.0.
# Not used by docker-compose.yml (build-from-source).
CKG_TAG=v1.1.0

# ABSOLUTE HOST path of this repo checkout. The loop worker bind-mounts it into
# each throwaway agent container, and the host docker daemon resolves it.
LOOP_HOST_REPO_PATH=/docker/ckg-ai

# Caddy site addresses (docker-compose.prod.yml). Defaults = IP-only plain HTTP:
# admin app + /api on :80, client dashboard on :8080. For domains, set both to
# hostnames and Caddy issues TLS itself (open 80 + 443):
# ADMIN_SITE=admin.example.com
# DASHBOARD_SITE=dashboard.example.com
# NEXT_PUBLIC_API_URL (below) and backend CORS_ORIGINS must match these.

NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP/api
