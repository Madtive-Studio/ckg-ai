# backend/.env on the VPS. Copy to backend/.env and fill real values.
# DATABASE_URL and REDIS_URL are OVERRIDDEN by docker-compose, so leave them
# blank or omit — compose injects the in-network values.

APP_ENV=production

# Admin seeded by alembic migration 0002_seed_admin on first `alembic upgrade head`.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_FULL_NAME=Root Admin

# External frontend-dashboard login pool (scope="prod"). Leave blank to skip seeding.
# Must DIFFER from ADMIN_EMAIL — admins.email is unique, so a clashing email
# makes the prod seed a no-op (ON CONFLICT DO NOTHING) and prod login won't work.
# Migration 0019 seeds this password VERBATIM — set a strong, unique value.
PROD_ADMIN_EMAIL=prod@yourdomain.com
PROD_ADMIN_PASSWORD=replace-with-strong-password
PROD_ADMIN_FULL_NAME=Prod Admin

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-48-byte-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENCRYPTION_KEY=replace-with-fernet-key

# JSON list. Must include the origin the BROWSER uses to load the frontend.
# Example IP-only behind host nginx on :80
CORS_ORIGINS=["http://YOUR_VPS_IP"]

# Public origin of frontend-dashboard (the client app). One-time ASIK credential links are built from it,
# so it must be the address clients actually open (e.g. http://YOUR_VPS_IP:8080 or https://dashboard.example.com).
DASHBOARD_PUBLIC_URL=http://YOUR_VPS_IP:8080

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxies in front of the backend. The login rate-limiter reads the
# client IP as the Nth-from-last X-Forwarded-For entry (un-spoofable). Set to the
# number of trusted proxies: 1 for a single host nginx (default), 0 if uvicorn is
# exposed directly (ignores XFF, uses the socket peer). A wrong value either lets
# attackers rotate the spoofed IP or buckets every user under the proxy's IP.
TRUSTED_PROXY_COUNT=1

# How many ASIK sync browsers a cron sync batch runs at once (shared ASIK login).
# Each extra Chromium costs ~400-600 MB on the 4 vCPU / 7.9 GB box; ramp slowly.
ASIK_SYNC_CONCURRENCY=2

# Leave SCRAPERS_ROOT empty — Dockerfile bakes /app/scrapers and config.py
# auto-resolves it. SCRAPER_SESSIONS_ROOT is set by docker-compose to the
# persistent volume mount; do not set it here.

OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai

# ---- Loop agent (optional; inert until an is_active_loop_agent llm_config exists) ----
# LOOP_HOST_REPO_PATH and LOOP_AGENT_IMAGE are set by docker-compose; do not set them here.
# GitHub token scoped to push-branch + open-PR. Unset = local-branch-only mode.
# LOOP_GITHUB_TOKEN=ghp_...
# LOOP_GITHUB_REPO=owner/repo
# Comma-separated GitHub handles. A PR's author cannot review their own PR, so put
# the author in ASSIGNEES only.
# LOOP_PR_REVIEWERS=
# LOOP_PR_ASSIGNEES=
# Pin the upstream provider for the agent + reviewer models (e.g. "z-ai").
# LOOP_LLM_ROUTE_ORDER=
# READ-ONLY Postgres role URL for the loop container's gate. Unset = it reuses the
# worker's DATABASE_URL (NOT read-only).
# LOOP_AGENT_DB_URL=postgresql+psycopg://ckg_readonly:...@postgres:5432/ckg_ai
